# RSM HMS — Clinical Service Environment Variables
# Copy this file to .env and fill in ALL required values before starting.
# Never commit .env to version control.
# Variables marked [REQUIRED] cause the server to refuse startup if missing.

# ─── Server ────────────────────────────────────────────────────────────────
# [REQUIRED] One of: development | test | production
NODE_ENV=development
# [OPTIONAL] HTTP port. Defaults to 3001.
PORT=3001

# ─── PostgreSQL Database ───────────────────────────────────────────────────
# [REQUIRED when DB_TYPE=postgres] For local dev, run: docker compose up -d
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=hms_user
DB_PASS=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=hms_db
# [OPTIONAL] Set true for managed cloud databases (AWS RDS, Azure, GCP)
DB_SSL=false

# ─── JWT Secrets ───────────────────────────────────────────────────────────
# [REQUIRED] Long random strings — the server throws if these are missing.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_128_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_128_CHAR_HEX_STRING

# ─── Cookie & Session Security ─────────────────────────────────────────────
# [REQUIRED] Used to sign cookies via cookie-parser.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── PII Encryption ────────────────────────────────────────────────────────
# [REQUIRED] 64-character hex string (32 bytes) for AES-256-GCM field encryption.
# Encrypts: patient name, DOB, SSN, contact, email, address, insurance number.
# WARNING: changing this key makes all existing encrypted patient data unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Redis ─────────────────────────────────────────────────────────────────
# [REQUIRED in production] Used for refresh token whitelisting and SSE Pub/Sub.
# [OPTIONAL in development] Set USE_REDIS_MOCK=true to skip a real Redis server.
REDIS_HOST=localhost
REDIS_PORT=6379
# [OPTIONAL] Leave blank if Redis has no auth configured
REDIS_PASSWORD=
# [OPTIONAL] true = use ioredis-mock (dev/test only, NOT for production)
USE_REDIS_MOCK=false

# ─── Frontend URL (CORS whitelist) ─────────────────────────────────────────
# [REQUIRED] Must match the exact origin of your frontend deployment.
FRONTEND_URL=http://localhost:5173

# ─── Observability ─────────────────────────────────────────────────────────
# [OPTIONAL] Sentry DSN for error tracking. Leave blank to disable.
# Obtain from https://sentry.io after creating a NestJS project.
SENTRY_DSN=
