# RSM HMS — Production Environment Configuration
# Copy this to .env for production deployment.
# NEVER commit .env files with real secrets to source control.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_TYPE=postgres
DB_HOST=your-postgres-host.rds.amazonaws.com
DB_PORT=5432
DB_USER=hms_prod_user
DB_PASS=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=hms_production
DB_SSL=true

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_64_CHAR_RANDOM_HEX_STRING

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=CHANGE_THIS_TO_32_CHAR_RANDOM_STRING

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://hms.yourhospital.com

# ─── File Storage (S3 / Azure Blob — for future document uploads) ─────────────
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=rsm-hms-documents
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ─── Email (SMTP — for patient notifications) ────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourhospital.com

# ─── Monitoring & Observability ──────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# LOG_LEVEL=warn
