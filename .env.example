# 🏥 RSM HMS — Universal Environment Template (clinical-service)

# ─── Server Configuration ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development  # production, development, test

# ─── Auth & Security (MANDATORY IN PRODUCTION) ──────────────────────────
# Use 'openssl rand -base64 32' to generate secure secrets
COOKIE_SECRET=hms-cookie-secret-CHANGE-ME
JWT_SECRET=hms-jwt-access-secret-CHANGE-ME
JWT_REFRESH_SECRET=hms-jwt-refresh-secret-CHANGE-ME

# ─── Database Configuration ─────────────────────────────────────────────
DB_TYPE=sqlite      # postgres, sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=hms_user
DB_PASS=hms_password
DB_NAME=hms_db
DB_SSL=false        # set to true for cloud DBs (RDS, Azure)

# ─── CORS & Frontend Integration ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Observability (Optional) ───────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug     # error, warn, log, debug, verbose

# 🏥 RSM HMS — Frontend (frontend/.env)
# VITE_API_BASE_URL=http://localhost:3001/api/v1
